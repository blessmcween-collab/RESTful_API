                        "title": "Items"
                    },
                    "total": {
                        "type": "integer",
                        "title": "Total",
                        "description": "Total books matching the filters (ignores pagination)"
                    },
                    "limit": {
                        "type": "integer",
                        "title": "Limit"
                    },
                    "offset": {
                        "type": "integer",
                        "title": "Offset"
                    }
                },
                "type": "object",
                "required": [
                    "items",
                    "total",
                    "limit",
                    "offset"
                ],
                "title": "BookList"
            },
