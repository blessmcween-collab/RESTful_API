            },
            "ErrorInfo": {
                "properties": {
                    "code": {
                        "type": "string",
                        "title": "Code",
                        "examples": [
                            "not_found"
                        ]
                    },
                    "message": {
                        "type": "string",
                        "title": "Message",
                        "examples": [
                            "Book with id 42 was not found"
                        ]
                    },
                    "details": {
                        "anyOf": [
                            {},
