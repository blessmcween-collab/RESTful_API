                                "exclusiveMinimum": 0.0,
                                "examples": [
                                    464
                                ]
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Pages"
                    },
                    "genre": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 50,
                                "minLength": 1,
                                "examples": [
                                    "Software Engineering"
                                ]
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Genre"
                    },
                    "available": {
                        "anyOf": [
